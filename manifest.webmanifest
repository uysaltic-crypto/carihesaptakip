{
  "id": "./",
  "name": "Cari Hesap Takip Programı",
  "short_name": "Cari Takip",
  "description": "Cari hesap, sefer, irsaliye ve vergi takibi",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#EEF1F6",
  "theme_color": "#17212F",
  "lang": "tr",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        { "name": "files", "accept": ["image/*", "application/pdf", ".pdf", ".jpg", ".jpeg", ".png", ".webp"] }
      ]
    }
  }
}
